# Файл конфигурации (переименуйте в .env перед запуском)

# Настройки PostgreSQL
POSTGRES_USER=sotrue_user
POSTGRES_PASSWORD=generate_a_very_secure_password_here
POSTGRES_DB=sotrue_db
DATABASE_URL=postgresql://sotrue_user:generate_a_very_secure_password_here@127.0.0.1/sotrue_db

# Настройки Redis
REDIS_PASSWORD=generate_a_very_secure_redis_password_here

# Настройки Meilisearch
MEILI_ENV=production
MEILI_MASTER_KEY=generate_a_very_secure_meili_master_key_here

# Учетные данные S3 (Yandex Cloud/AWS)
S3_ENDPOINT=https://s3.yandexcloud.net
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=sotrue-images

# Учетные данные СДЭК
SDEK_CLIENT_ID=your_cdek_client_id
SDEK_CLIENT_SECRET=your_cdek_client_secret
